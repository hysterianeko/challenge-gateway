# 时区
TZ=Asia/Shanghai

# 和求解器共享的口令，自己生成一段随机字符串
CLIENTT_KEY=change_me_to_a_random_string

# HTTPS 域名，Caddy 自动申请并续签 Let's Encrypt
DOMAIN=challenge.cool.pp.ua
ACME_EMAIL=admin@challenge.cool.pp.ua
ENABLE_TLS=true

# 过渡期仍可把 Cloudflyer 原生 3000 映射出来给旧客户端
# 正式走 HTTPS 后可改成 127.0.0.1
CLOUDFLYER_BIND=0.0.0.0

CHALLENGE_IMAGE=challenge-gateway:latest
CLOUDFLYER_MAX_TASKS=1
CLOUDFLYER_TIMEOUT=120

# 仅在仍暴露 3000 时生效
ALLOWED_IPS=62.192.173.239
